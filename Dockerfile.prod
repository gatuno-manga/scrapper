# syntax=docker/dockerfile:1.4
# Stage 1: Build the Go application
FROM golang:1.26-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends git ca-certificates

# Copy dependency files and download
ENV GOPROXY="https://proxy.golang.org,direct"
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download || go mod download || go mod download

# Copy source code
COPY . .

# Build the application
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -v -o scraper ./cmd/scraper

# Download the Playwright driver into /pw-driver (only the driver, not browsers)
# PLAYWRIGHT_DRIVER_PATH tells playwright-go where to store/find the driver.
ENV PLAYWRIGHT_DRIVER_PATH=/pw-driver
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run ./cmd/pwinstall

# Stage 2: Final minimal image
FROM debian:12-slim

# curl is needed for the container healthcheck (docker-compose.prod.yml)
# against the ops server's /readyz endpoint (OBS-06).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends curl

RUN groupadd --system nonroot && useradd --system -g nonroot nonroot

WORKDIR /app

# Copy the binary from the builder
COPY --from=builder --chown=nonroot:nonroot /app/scraper .

# Copy the pre-downloaded Playwright driver — zero CDN downloads at runtime!
COPY --from=builder --chown=nonroot:nonroot /pw-driver /pw-driver

# Tell playwright-go onde encontrar o driver em disco (sem precisar baixar)
ENV PLAYWRIGHT_DRIVER_PATH=/pw-driver

# Set user to nonroot
USER nonroot

ENTRYPOINT ["./scraper"]
