# syntax=docker/dockerfile:1.4
FROM golang:1.26-bookworm

RUN rm -f /etc/apt/apt.conf.d/docker-clean; echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates tzdata

WORKDIR /app

# Install Air for hot-reload
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@v1.67.4

# Copy dependency files
ENV GOPROXY="https://proxy.golang.org,direct"
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download || go mod download || go mod download

# Install Playwright driver
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run github.com/mxschmitt/playwright-go/cmd/playwright install --with-deps

# Copy source code so the image is self-sufficient at build time.
# Compose Watch's sync action only pushes changes made after the container
# starts — it does not perform an initial copy — so without this, air has
# nothing to serve (.air.toml missing) until the first file edit.
COPY . .

# Expose port for health checks or metrics if any
EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
